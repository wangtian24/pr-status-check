# PR Status Dashboard configuration
# Copy this file to config.yml and edit to your needs:
#   cp config.yml.example config.yml

# Auto-discover all angellist repos from a local workspace directory.
# Scans each subdirectory for a git remote belonging to the angellist org.
# If set, explicit 'repos' below are ignored.
workspace: ~/workspace

# Alternatively, list specific repos to monitor (full URLs or owner/name shorthand).
# Only used if 'workspace' is not set.
# repos:
#   - https://github.com/angellist/repo1
#   - angellist/repo2

# Port to serve the dashboard on (default: 9600)
# port: 9600

# Data refresh interval in seconds (default: 300)
# interval: 300
